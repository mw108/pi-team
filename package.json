{
  "name": "pi-team",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic, resumable development team for Pi",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run format:check && npm test",
    "format": "prettier --write src tests scripts config templates README.md docs/investigation.md package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts config templates README.md docs/investigation.md package.json tsconfig.json",
    "doctor": "tsx scripts/doctor.ts",
    "smoke": "tsx scripts/smoke.ts",
    "pi": "pi"
  },
  "dependencies": {
    "@bacnh85/pi-serena": "0.9.18",
    "@eko24ive/pi-ask": "1.2.0",
    "pi-mcp-adapter": "3.0.0",
    "pi-web-access": "0.32.0",
    "yaml": "2.8.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.0",
    "@earendil-works/pi-coding-agent": "0.99.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.22.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
